#!/usr/bin/env bash
# OS packages + login shell. The only unix step that needs sudo.
# chezmoi re-runs this whenever the rendered content (i.e. the package lists in
# .chezmoidata/packages.yaml) changes.
set -uo pipefail
{{ if .noRoot -}}
echo "[packages] noRoot=true - skipping apt/brew and chsh (fish comes from mise instead)"
exit 0
{{- end }}

GREEN="\033[0;32m"; RED="\033[0;31m"; BLUE="\033[0;34m"; NC="\033[0m"
LOG_DIR="${TMPDIR:-/tmp}/dotfiles-packages"
mkdir -p "$LOG_DIR"
failures=()

# step NAME CMD... : run a step, log to $LOG_DIR/NAME.log, keep going on failure
step() {
   local name="$1"; shift
   local log="$LOG_DIR/${name//\//_}.log"
   printf "${BLUE}==> %s${NC}\n" "$name"
   if "$@" >"$log" 2>&1; then
      printf "${GREEN}    ok${NC}\n"
   else
      printf "${RED}    FAILED - see %s${NC}\n" "$log"
      tail -n 5 "$log" | sed 's/^/      /'
      failures+=("$name")
   fi
}

{{ if eq .chezmoi.os "darwin" -}}
# ---------- macOS: Homebrew ----------
if ! command -v brew >/dev/null 2>&1 && [ ! -x /opt/homebrew/bin/brew ]; then
   installer="$(mktemp)"
   curl -fsSL -o "$installer" "https://raw.githubusercontent.com/Homebrew/install/{{ .pins.homebrewInstall.commit }}/install.sh"
   echo "{{ .pins.homebrewInstall.sha256 }}  $installer" | shasum -a 256 -c - || { echo "Homebrew installer checksum mismatch"; exit 1; }
   NONINTERACTIVE=1 /bin/bash "$installer"
   rm -f "$installer"
fi
eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv)"

{{ range .packages.darwin.brews -}}
step "brew {{ . }}" brew install {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
step "cask {{ . }}" brew install --cask {{ . | quote }}
{{ end -}}
{{ if not .isWork -}}
{{ range .packages.personal.darwin.casks -}}
step "cask {{ . }}" brew install --cask {{ . | quote }}
{{ end -}}
{{ end -}}
FISH_PATH="$(brew --prefix)/bin/fish"

{{- else if eq .chezmoi.os "linux" }}
# ---------- Debian / Ubuntu / Raspberry Pi OS: apt ----------
sudo -v || { echo "sudo is required (or re-run chezmoi init with noRoot=true)"; exit 1; }
export DEBIAN_FRONTEND=noninteractive
# Retries ride out transient mirror errors (e.g. HTTP 5xx from archive.ubuntu.com).
APT="sudo -E apt-get -y -q -o Acquire::Retries=5"

# retry CMD...: up to 3 tries, 15s then 30s apart, for steps that hit the network
retry() {
   local n
   for n in 1 2 3; do
      "$@" && return 0
      [ "$n" -lt 3 ] && sleep $((n * 15))
   done
   return 1
}

step "apt update" retry $APT update

# Ubuntu: newer fish from the official fish PPA (Launchpad-signed).
if grep -qi '^ID=ubuntu' /etc/os-release && ! ls /etc/apt/sources.list.d/ 2>/dev/null | grep -q fish-shell; then
   step "apt software-properties-common" $APT install software-properties-common
   step "fish PPA" sudo add-apt-repository -y ppa:fish-shell/release-4
   step "apt update (fish PPA)" retry $APT update
fi

# apt_install A [B...]: install the first package this release has a candidate for
apt_install() {
   local p
   for p in "$@"; do
      if apt-cache policy "$p" 2>/dev/null | grep -q 'Candidate: [0-9]'; then
         $APT install "$p"
         return
      fi
   done
   $APT install "$1"
}

{{ range .packages.linux.apt -}}
step "apt {{ . }}" apt_install{{ range splitList "|" . }} {{ trim . | quote }}{{ end }}
{{ end -}}

{{- if eq (includeTemplate "bitwarden_enabled.tmpl" .) "true" }}
# Bitwarden desktop (SSH agent): pinned .deb, checked against pins.yaml.
install_bitwarden() {
   local deb
   deb="$(mktemp --suffix=.deb)"
   curl -fsSL -o "$deb" "https://github.com/bitwarden/clients/releases/download/desktop-v{{ .pins.bitwardenDeb.version }}/Bitwarden-{{ .pins.bitwardenDeb.version }}-amd64.deb"
   echo "{{ .pins.bitwardenDeb.sha256 }}  $deb" | sha256sum -c - || { echo "Bitwarden .deb checksum mismatch"; rm -f "$deb"; return 1; }
   # apt fetches local .debs as the unprivileged _apt user
   chmod 0644 "$deb"
   $APT install "$deb"
   local rc=$?
   rm -f "$deb"
   return $rc
}
step "bitwarden {{ .pins.bitwardenDeb.version }}" install_bitwarden
{{- end }}

{{- if .xpra }}
# xpra: distro builds lag years behind and lack the HTML5 client, so use
# xpra.org's repo. Its signing key is checked against pins.yaml first.
add_xpra_repo() {
   local key codename
   key="$(mktemp)"
   curl -fsSL -o "$key" https://xpra.org/xpra.asc
   echo "{{ .pins.xpraKey.sha256 }}  $key" | sha256sum -c - || { echo "xpra key checksum mismatch"; rm -f "$key"; return 1; }
   sudo install -m 0644 "$key" /usr/share/keyrings/xpra.asc
   rm -f "$key"
   codename="$(. /etc/os-release && echo "$VERSION_CODENAME")"
   printf 'Types: deb\nURIs: https://xpra.org\nSuites: %s\nComponents: main\nSigned-By: /usr/share/keyrings/xpra.asc\n' "$codename" |
      sudo tee /etc/apt/sources.list.d/xpra.sources >/dev/null
}
step "xpra apt repo" add_xpra_repo
step "apt update (xpra)" retry $APT update
{{ range .packages.linux.xpra -}}
step "apt {{ . }}" $APT install {{ . | quote }}
{{ end -}}
# Keep the user's systemd instance (and so the xpra service) up without a login.
if [ -d /run/systemd/system ]; then
   step "loginctl enable-linger" sudo loginctl enable-linger "${USER:-$(id -un)}"
fi
{{- end }}

{{- if .isPi }}
# Raspberry Pi: sqlite.lua (yanky) looks for an unversioned libsqlite3.so
if [ ! -e /usr/lib/libsqlite3.so ]; then
   lib="$(ls /usr/lib/*-linux-gnu*/libsqlite3.so.0 2>/dev/null | head -n1)"
   [ -n "$lib" ] && step "libsqlite3.so symlink" sudo ln -s "$lib" /usr/lib/libsqlite3.so
fi
{{- end }}
FISH_PATH="$(command -v fish || echo /usr/bin/fish)"
{{- end }}

# ---------- login shell -> fish ----------
ME="${USER:-$(id -un)}"
if [ -x "$FISH_PATH" ]; then
   grep -qxF "$FISH_PATH" /etc/shells || step "register fish in /etc/shells" sudo sh -c "echo '$FISH_PATH' >> /etc/shells"
   {{ if eq .chezmoi.os "darwin" -}}
   current_shell="$(dscl . -read "/Users/$ME" UserShell | awk '{print $2}')"
   {{- else -}}
   current_shell="$(getent passwd "$ME" | cut -d: -f7)"
   {{- end }}
   if [ "$current_shell" != "$FISH_PATH" ]; then
      step "chsh -> fish" sudo chsh -s "$FISH_PATH" "$ME"
   fi
fi

if [ ${#failures[@]} -gt 0 ]; then
   printf "${RED}[packages] %d step(s) failed:${NC}\n" "${#failures[@]}"
   printf "  - %s\n" "${failures[@]}"
   echo "Fix them, then re-run with:  chezmoi state delete-bucket --bucket=entryState && chezmoi apply"
   # Strict mode (CI) fails the apply; interactive installs carry on so one
   # broken package doesn't block the rest of the setup.
   [ "${DOTFILES_STRICT:-}" = "1" ] && exit 1
fi
exit 0
