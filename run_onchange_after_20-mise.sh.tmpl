#!/usr/bin/env bash
# Install mise (pinned + sha256-verified, user space, no sudo) and every dev
# tool in ~/.config/mise. Re-runs when the mise config or lockfile changes:
#   config:   {{ include "dot_config/mise/config.toml" | sha256sum }}
#   lock:     {{ include "dot_config/mise/mise.lock" | sha256sum }}
#   overlays: {{ include "dot_config/mise/conf.d/no-root.toml" | sha256sum }} {{ include "dot_config/mise/conf.d/armv7.toml" | sha256sum }} {{ include "dot_config/mise/conf.d/work.toml" | sha256sum }}
set -euo pipefail

MISE_VERSION="{{ .pins.mise.version }}"
BIN_DIR="$HOME/.local/bin"
MISE="$BIN_DIR/mise"

{{ $platform := "" -}}
{{ if eq .chezmoi.os "darwin" -}}
{{   $platform = printf "macos-%s" (eq .chezmoi.arch "arm64" | ternary "arm64" "x64") -}}
{{ else if eq .chezmoi.arch "amd64" -}}
{{   $platform = "linux-x64" -}}
{{ else if eq .chezmoi.arch "arm64" -}}
{{   $platform = "linux-arm64" -}}
{{ else if eq .chezmoi.arch "arm" -}}
{{   $platform = "linux-armv7" -}}
{{ else -}}
{{   fail (printf "mise: unsupported platform %s/%s" .chezmoi.os .chezmoi.arch) -}}
{{ end -}}
PLATFORM="{{ $platform }}"
EXPECTED_SHA="{{ index .pins.mise.sha256 $platform }}"

sha256() { if command -v sha256sum >/dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | awk '{print $1}'; }

if [ ! -x "$MISE" ] || ! "$MISE" --version 2>/dev/null | grep -q "^$MISE_VERSION "; then
   echo "[mise] installing mise $MISE_VERSION ($PLATFORM)"
   tmp="$(mktemp -d)"
   trap 'rm -rf "$tmp"' EXIT
   curl -fsSL -o "$tmp/mise.tar.gz" \
      "https://github.com/jdx/mise/releases/download/v$MISE_VERSION/mise-v$MISE_VERSION-$PLATFORM.tar.gz"
   actual="$(sha256 "$tmp/mise.tar.gz")"
   if [ "$actual" != "$EXPECTED_SHA" ]; then
      echo "[mise] CHECKSUM MISMATCH - expected $EXPECTED_SHA got $actual. Refusing to install." >&2
      exit 1
   fi
   tar -xzf "$tmp/mise.tar.gz" -C "$tmp"
   mkdir -p "$BIN_DIR"
   install -m 0755 "$tmp/mise/bin/mise" "$MISE"
fi

echo "[mise] installing tools from ~/.config/mise (verified against mise.lock)"
cd "$HOME"
"$MISE" install --yes
"$MISE" reshim
