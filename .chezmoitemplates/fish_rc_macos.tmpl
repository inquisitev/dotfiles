
source {{.chezmoi.sourceDir}}/.chezmoitemplates/mac_os_tools.fish

{{ range .packages.linux.custom -}}
init_{{ . }}
{{ end -}}

if test -f ~/.config/fish/work_bash_rc.fish
    source ~/.config/fish/work_bash_rc.fish
end


export PATH="/opt/homebrew/bin:$PATH"

set -g theme_powerline_fonts no

function devcontainer_setup --description "Run dotfiles/ssh setup inside dev container"
    devcontainer exec --workspace-folder . bash -lc '
        DOTFILES=$HOME/.local/share/chezmoi;
        mkdir -p $HOME/.ssh $HOME/.local/share;
        ssh-keyscan github.com >> $HOME/.ssh/known_hosts;
        chmod 700 $HOME/.ssh; chmod 600 $HOME/.ssh/known_hosts;
        if [ ! -d "$DOTFILES/.git" ]; then
          sudo git clone git@github.com:inquisitev/dotfiles.git "$DOTFILES" && "$DOTFILES/install.sh";
        else
          sudo /usr/bin/chezmoi update
        fi'
end

function devcontainer_rebuild --description "Rebuild dev container and run setup"
    devcontainer up --workspace-folder . --remove-existing-container
    or return 1
    devc_setup
end

function devcontainer_enter --description "Enter dev container (interactive fish shell)"
    devcontainer exec --workspace-folder . fish -l
end

function devcontainer_build --description "Build dev container and run setup"
    devcontainer up --workspace-folder .
    or return 1
    devc_setup
end




