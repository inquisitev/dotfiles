#!{{ lookPath "bash" }}
{{ if eq .chezmoi.os "linux" -}}
sudo apt update
{{ range .packages.linux.apt -}}
sudo apt install -y {{ . | quote }}
{{ end -}}

{{- $isRaspian := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{- if contains "rpi" .chezmoi.kernel.osrelease -}}
{{- $isRaspian = true -}}
{{- end -}}
{{- end -}}

{{ if eq .chezmoi.os "linux" -}}
{{ range .packages.linux.apt -}}
sudo apt install -y {{ . | quote }}
{{ end -}}
{{ end -}}

{{- if $isRaspian }}
source  .chezmoitemplates/raspberry_pi_tools.sh
{{ end -}}


{{ if eq .chezmoi.os "linux" -}}
source {{.chezmoi.sourceDir}}/.chezmoitemplates/linux_tools.sh

{{ range .packages.linux.custom -}}
install_{{ . }}
{{ end -}}

{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
source  .chezmoitemplates/mac_os_tools.sh
{{ end -}}


{{ end -}}