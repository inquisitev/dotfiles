#!{{ lookPath "bash" }}

# Run once install scripts

{{- $isRaspian := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{- if contains "rpi" .chezmoi.kernel.osrelease -}}
{{- $isRaspian = true -}}
{{- end -}}
{{- end -}}

{{ if eq .chezmoi.os "linux" -}}
echo "Setting up linux"
{{ template "linux_initial_setup.sh" . -}}
{{ else if $isRaspian -}}
echo "Setting up raspian"
{{ template "raspberry_pi_initial_setup.sh" . -}}
{{ else if eq .chezmoi.os "darwin" -}}
echo "Setting up mac os"
{{ template "mac_os_initial_setup.sh" . -}}
{{ else -}}
{{ fail "Unsupported OS: " .chezmoi.os }}
{{ end -}}
